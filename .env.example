# Lead email inbox (already defaults to info@testsynclab.com in code)
# SITE_EMAIL=info@testsynclab.com

# Option A — Hostinger mailbox SMTP (REQUIRED for clean lead emails)
# Without this, forms fall back to FormSubmit which adds a “Sponsor” ad footer.
# Also required for Become-a-tester CV attachments.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@testsynclab.com
SMTP_PASS=

# Option B — Resend API (fallback if SMTP not set)
RESEND_API_KEY=
# Optional verified sender, e.g. TestSync Lab <info@testsynclab.com>
# RESEND_FROM=

# Option C — Brevo API (fallback)
# BREVO_API_KEY=
# BREVO_FROM=info@testsynclab.com

# Optional Calendly / Cal.com — when set, “Book a call” CTAs appear on /contact
# Free setup: see outreach/calendly-setup.md
# NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-link/20min

# Google Analytics 4 (free) — Measurement ID like G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
