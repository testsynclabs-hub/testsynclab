# Lead email inbox (already defaults to info@testsynclab.com in code)
# SITE_EMAIL=info@testsynclab.com

# Option A — Hostinger mailbox SMTP (recommended; emails arrive in info@)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@testsynclab.com
SMTP_PASS=

# Option B — Resend API (fallback if SMTP not set)
RESEND_API_KEY=

# Google Analytics 4 (free) — Measurement ID like G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
